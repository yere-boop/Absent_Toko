<div class="form-page">
  <div class="form-page-header">
    <a href="/attendances" class="btn btn-secondary btn-sm">
      <i data-lucide="arrow-left"></i>
      Kembali
    </a>
  </div>

  <div class="card form-card">
    <div class="card-header">
      <h2 class="card-title">
        <i data-lucide="plus-circle"></i>
        Tambah Data Absensi
      </h2>
    </div>
    <div class="card-body">
      <form action="/attendances" method="POST" id="attendanceForm" novalidate>
        <div class="form-grid">
          <!-- Karyawan -->
          <div class="form-group form-full">
            <label for="employee_id">Karyawan <span class="required">*</span></label>
            <select id="employee_id" name="employee_id" class="form-control" required>
              <option value="">-- Pilih Karyawan --</option>
              <% employees.forEach(function(emp) { %>
                <option value="<%= emp.id %>"
                  <%= (typeof old !== 'undefined' && old.employee_id == emp.id) ? 'selected' : '' %>>
                  <%= emp.name %><% if (emp.position) { %> — <%= emp.position %><% } %>
                </option>
              <% }); %>
            </select>
          </div>

          <!-- Tanggal -->
          <div class="form-group">
            <label for="date">Tanggal <span class="required">*</span></label>
            <input type="date" id="date" name="date" class="form-control"
              value="<%= typeof old !== 'undefined' && old.date ? old.date : new Date().toISOString().split('T')[0] %>"
              required>
          </div>

          <!-- Status -->
          <div class="form-group">
            <label for="status">Status Absensi <span class="required">*</span></label>
            <select id="status" name="status" class="form-control" required>
              <option value="">-- Pilih Status --</option>
              <option value="Hadir"       <%= (typeof old !== 'undefined' && old.status === 'Hadir') ? 'selected' : '' %>>✅ Hadir</option>
              <option value="Tidak Hadir" <%= (typeof old !== 'undefined' && old.status === 'Tidak Hadir') ? 'selected' : '' %>>❌ Tidak Hadir</option>
              <option value="Setengah Hari" <%= (typeof old !== 'undefined' && old.status === 'Setengah Hari') ? 'selected' : '' %>>🕐 Setengah Hari</option>
              <option value="Lembur"      <%= (typeof old !== 'undefined' && old.status === 'Lembur') ? 'selected' : '' %>>🌙 Lembur</option>
            </select>
          </div>

          <!-- Jam Kedatangan (tampil jika Hadir/Lembur) -->
          <div class="form-group" id="arrivalGroup">
            <label for="arrival_time">
              Jam Masuk <span class="required" id="arrivalRequired" style="display:none;">*</span>
            </label>
            <input type="time" id="arrival_time" name="arrival_time" class="form-control"
              value="<%= typeof old !== 'undefined' && old.arrival_time ? old.arrival_time : '' %>">
          </div>

          <!-- Lembur checkbox (tampil jika Hadir) -->
          <div class="form-group form-full" id="overtimeGroup" style="display:none;">
            <div class="checkbox-card" id="overtimeCard">
              <label class="checkbox-label-full">
                <input type="checkbox" id="is_overtime" name="is_overtime" value="on"
                  <%= (typeof old !== 'undefined' && old.is_overtime === 'on') ? 'checked' : '' %>>
                <span class="checkbox-custom"></span>
                <div class="checkbox-text">
                  <strong>🌙 Lembur</strong>
                  <small>Tandai jika karyawan ini melakukan lembur hari ini</small>
                </div>
              </label>
            </div>
          </div>

          <!-- Keterangan (tampil jika Tidak Hadir atau Setengah Hari) -->
          <div class="form-group form-full" id="descriptionGroup" style="display:none;">
            <label for="description">
              Keterangan
              <span class="form-hint">(Opsional — alasan tidak hadir / setengah hari)</span>
            </label>
            <textarea id="description" name="description" class="form-control" rows="3"
              placeholder="Contoh: Sakit, Urusan keluarga, dll"><%= typeof old !== 'undefined' && old.description ? old.description : '' %></textarea>
          </div>
        </div>

        <div class="form-actions">
          <a href="/attendances" class="btn btn-secondary">Batal</a>
          <button type="submit" class="btn btn-primary">
            <i data-lucide="save"></i>
            Simpan Absensi
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  const statusSelect = document.getElementById('status');
  const arrivalGroup = document.getElementById('arrivalGroup');
  const arrivalInput = document.getElementById('arrival_time');
  const arrivalRequired = document.getElementById('arrivalRequired');
  const overtimeGroup = document.getElementById('overtimeGroup');
  const descGroup = document.getElementById('descriptionGroup');
  const descInput = document.getElementById('description');

  function toggleFields() {
    const val = statusSelect.value;

    if (val === 'Hadir') {
      overtimeGroup.style.display = 'block';
      descGroup.style.display = 'none';
      arrivalInput.required = true;
      arrivalRequired.style.display = 'inline';
      descInput.required = false;
    } else if (val === 'Lembur') {
      overtimeGroup.style.display = 'none';
      descGroup.style.display = 'none';
      arrivalInput.required = true;
      arrivalRequired.style.display = 'inline';
      descInput.required = false;
    } else if (val === 'Setengah Hari') {
      overtimeGroup.style.display = 'none';
      descGroup.style.display = 'block';
      arrivalInput.required = true;
      arrivalRequired.style.display = 'inline';
      descInput.required = false;
    } else if (val === 'Tidak Hadir') {
      overtimeGroup.style.display = 'none';
      descGroup.style.display = 'block';
      arrivalInput.required = false;
      arrivalRequired.style.display = 'none';
      descInput.required = false;
    } else {
      overtimeGroup.style.display = 'none';
      descGroup.style.display = 'none';
      arrivalInput.required = false;
      arrivalRequired.style.display = 'none';
      descInput.required = false;
    }
  }

  statusSelect.addEventListener('change', toggleFields);
  toggleFields(); // run on load for old values
</script>
