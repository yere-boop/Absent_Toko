<div class="page-actions">
  <a href="/attendances/create" class="btn btn-primary">
    <i data-lucide="plus-circle"></i>
    Tambah Absensi
  </a>
</div>

<div class="card">
  <div class="card-header">
    <h2 class="card-title">
      <i data-lucide="clipboard-list"></i>
      Data Absensi
    </h2>
    <span class="badge-count"><%= attendances.length %> data</span>
  </div>

  <!-- Filter Bar -->
  <div class="filter-bar">
    <form action="/attendances" method="GET" class="filter-form">
      <div class="filter-group filter-group-wrap">
        <div class="search-box">
          <i data-lucide="search"></i>
          <input type="text" name="search" placeholder="Cari nama karyawan..." value="<%= filters.search %>" class="form-control">
        </div>
        <input type="date" name="dateFrom" value="<%= filters.dateFrom %>" class="form-control" title="Dari Tanggal">
        <input type="date" name="dateTo" value="<%= filters.dateTo %>" class="form-control" title="Sampai Tanggal">
        <select name="status" class="form-control">
          <option value="">Semua Status</option>
          <option value="Hadir"         <%= filters.status === 'Hadir' ? 'selected' : '' %>>✅ Hadir</option>
          <option value="Tidak Hadir"   <%= filters.status === 'Tidak Hadir' ? 'selected' : '' %>>❌ Tidak Hadir</option>
          <option value="Setengah Hari" <%= filters.status === 'Setengah Hari' ? 'selected' : '' %>>🕐 Setengah Hari</option>
          <option value="Lembur"        <%= filters.status === 'Lembur' ? 'selected' : '' %>>🌙 Lembur</option>
        </select>
        <button type="submit" class="btn btn-primary">
          <i data-lucide="filter"></i>
          Filter
        </button>
        <a href="/attendances" class="btn btn-secondary">
          <i data-lucide="refresh-cw"></i>
          Reset
        </a>
      </div>
    </form>
  </div>

  <div class="card-body">
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th class="col-hide-mobile">No</th>
            <th>Nama Karyawan</th>
            <th class="col-hide-mobile">Jabatan</th>
            <th>Tanggal</th>
            <th>Status</th>
            <th class="col-hide-mobile">Jam Masuk</th>
            <th class="col-hide-mobile">Lembur</th>
            <th class="col-hide-mobile">Keterangan</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (attendances.length === 0) { %>
            <tr>
              <td colspan="9" class="text-center text-muted">
                <div class="empty-state">
                  <i data-lucide="clipboard"></i>
                  <p>Tidak ada data absensi ditemukan</p>
                </div>
              </td>
            </tr>
          <% } else { %>
            <% attendances.forEach(function(a, i) { %>
              <tr>
                <td class="col-hide-mobile"><%= i + 1 %></td>
                <td>
                  <div class="employee-name-cell">
                    <div class="employee-avatar"><%= a.employee_name.charAt(0).toUpperCase() %></div>
                    <div>
                      <strong><%= a.employee_name %></strong>
                      <small class="text-muted d-block col-hide-desktop"><%= a.position || '' %></small>
                    </div>
                  </div>
                </td>
                <td class="col-hide-mobile"><%= a.position || '-' %></td>
                <td>
                  <%= new Date(a.date + 'T00:00:00').toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) %>
                </td>
                <td>
                  <% if (a.status === 'Hadir') { %>
                    <span class="badge badge-success">
                      <i data-lucide="check"></i> Hadir
                      <% if (a.is_overtime) { %><span class="badge-overtime">+L</span><% } %>
                    </span>
                  <% } else if (a.status === 'Lembur') { %>
                    <span class="badge" style="background:#8b5cf6; color:white;">
                      <i data-lucide="moon"></i> Lembur
                    </span>
                  <% } else if (a.status === 'Tidak Hadir') { %>
                    <span class="badge badge-danger"><i data-lucide="x"></i> Tidak Hadir</span>
                  <% } else if (a.status === 'Setengah Hari') { %>
                    <span class="badge badge-warning"><i data-lucide="clock"></i> Setengah Hari</span>
                  <% } else { %>
                    <span class="badge badge-secondary"><%= a.status %></span>
                  <% } %>
                </td>
                <td class="col-hide-mobile">
                  <% if (a.arrival_time) { %>
                    <span class="time-badge"><i data-lucide="clock-3"></i> <%= a.arrival_time %></span>
                  <% } else { %>
                    <span class="text-muted">-</span>
                  <% } %>
                </td>
                <td class="col-hide-mobile">
                  <% if (a.is_overtime) { %>
                    <span class="badge badge-overtime-pill">🌙 Lembur</span>
                  <% } else { %>
                    <span class="text-muted">-</span>
                  <% } %>
                </td>
                <td class="text-muted col-hide-mobile"><%= a.description || '-' %></td>
                <td>
                  <div class="action-buttons">
                    <a href="/attendances/<%= a.id %>" class="btn btn-xs btn-info" title="Detail">
                      <i data-lucide="eye"></i>
                    </a>
                    <a href="/attendances/<%= a.id %>/edit" class="btn btn-xs btn-warning" title="Edit">
                      <i data-lucide="edit-2"></i>
                    </a>
                    <button class="btn btn-xs btn-danger" title="Hapus"
                      onclick="confirmDelete('/attendances/<%= a.id %>', 'Hapus absensi <%= a.employee_name %>?')">
                      <i data-lucide="trash-2"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
