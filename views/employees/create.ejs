<div class="form-page">
  <div class="form-page-header">
    <a href="/employees" class="btn btn-secondary btn-sm">
      <i data-lucide="arrow-left"></i>
      Kembali
    </a>
  </div>

  <div class="card form-card">
    <div class="card-header">
      <h2 class="card-title">
        <i data-lucide="user-plus"></i>
        Tambah Karyawan Baru
      </h2>
    </div>
    <div class="card-body">
      <form action="/employees" method="POST" id="employeeForm" novalidate>
        <div class="form-grid">
          <div class="form-group">
            <label for="employee_code">Nomor Karyawan (NIK) <span class="required">*</span></label>
            <input type="text" id="employee_code" name="employee_code" class="form-control"
              placeholder="Contoh: KRY-001"
              value="<%= typeof old !== 'undefined' && old.employee_code ? old.employee_code : '' %>"
              required>
            <span class="form-hint">Nomor unik untuk setiap karyawan</span>
          </div>

          <div class="form-group">
            <label for="name">Nama Lengkap <span class="required">*</span></label>
            <input type="text" id="name" name="name" class="form-control"
              placeholder="Masukkan nama lengkap"
              value="<%= typeof old !== 'undefined' && old.name ? old.name : '' %>"
              required>
          </div>

          <div class="form-group">
            <label for="position">Jabatan <span class="required">*</span></label>
            <input type="text" id="position" name="position" class="form-control"
              placeholder="Contoh: Staff IT, Manager"
              value="<%= typeof old !== 'undefined' && old.position ? old.position : '' %>"
              required>
          </div>

          <div class="form-group">
            <label for="department">Departemen <span class="required">*</span></label>
            <input type="text" id="department" name="department" class="form-control"
              placeholder="Contoh: IT, Keuangan, HRD"
              value="<%= typeof old !== 'undefined' && old.department ? old.department : '' %>"
              list="departmentList"
              required>
            <datalist id="departmentList">
              <% if (typeof departments !== 'undefined') { %>
                <% departments.forEach(function(d) { %>
                  <option value="<%= d %>">
                <% }); %>
              <% } %>
            </datalist>
          </div>

          <div class="form-group">
            <label for="phone">Nomor Telepon</label>
            <input type="tel" id="phone" name="phone" class="form-control"
              placeholder="Contoh: 081234567890"
              value="<%= typeof old !== 'undefined' && old.phone ? old.phone : '' %>">
          </div>

          <div class="form-group">
            <label for="status">Status Karyawan <span class="required">*</span></label>
            <select id="status" name="status" class="form-control" required>
              <option value="Aktif" <%= (typeof old === 'undefined' || !old.status || old.status === 'Aktif') ? 'selected' : '' %>>Aktif</option>
              <option value="Tidak Aktif" <%= (typeof old !== 'undefined' && old.status === 'Tidak Aktif') ? 'selected' : '' %>>Tidak Aktif</option>
            </select>
          </div>

          <div class="form-group form-full">
            <label for="address">Alamat</label>
            <textarea id="address" name="address" class="form-control" rows="3"
              placeholder="Masukkan alamat lengkap"><%= typeof old !== 'undefined' && old.address ? old.address : '' %></textarea>
          </div>
        </div>

        <div class="form-actions">
          <a href="/employees" class="btn btn-secondary">Batal</a>
          <button type="submit" class="btn btn-primary">
            <i data-lucide="save"></i>
            Simpan Karyawan
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
