<div class="dashboard-page">
  <!-- Stats Cards -->
  <div class="stats-grid">
    <div class="stat-card stat-primary">
      <div class="stat-icon"><i data-lucide="users"></i></div>
      <div class="stat-info">
        <span class="stat-value"><%= totalEmployees %></span>
        <span class="stat-label">Total Karyawan</span>
      </div>
      <div class="stat-decoration"></div>
    </div>

    <div class="stat-card stat-success">
      <div class="stat-icon"><i data-lucide="user-check"></i></div>
      <div class="stat-info">
        <span class="stat-value"><%= todayStats['Hadir'] %></span>
        <span class="stat-label">Hadir Hari Ini</span>
      </div>
      <div class="stat-decoration"></div>
    </div>

    <div class="stat-card stat-warning">
      <div class="stat-icon"><i data-lucide="user-minus"></i></div>
      <div class="stat-info">
        <span class="stat-value"><%= todayStats['Setengah Hari'] %></span>
        <span class="stat-label">Setengah Hari</span>
      </div>
      <div class="stat-decoration"></div>
    </div>

    <div class="stat-card stat-danger">
      <div class="stat-icon"><i data-lucide="user-x"></i></div>
      <div class="stat-info">
        <span class="stat-value"><%= todayStats['Tidak Hadir'] %></span>
        <span class="stat-label">Tidak Hadir</span>
      </div>
      <div class="stat-decoration"></div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="quick-actions">
    <a href="/attendances/create" class="quick-action-btn">
      <i data-lucide="plus-circle"></i>
      <span>Isi Absen</span>
    </a>
    <a href="/employees/create" class="quick-action-btn">
      <i data-lucide="user-plus"></i>
      <span>Tambah Orang</span>
    </a>
    <a href="/recap/weekly" class="quick-action-btn">
      <i data-lucide="calendar-range"></i>
      <span>Rekap Mingguan</span>
    </a>
    <a href="/recap" class="quick-action-btn">
      <i data-lucide="file-bar-chart"></i>
      <span>Rekap Bulanan</span>
    </a>
  </div>

  <!-- Recent Attendance Table -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">
        <i data-lucide="clock"></i>
        Absensi Terbaru
      </h2>
      <a href="/attendances" class="btn btn-sm btn-outline">
        Lihat Semua
        <i data-lucide="arrow-right"></i>
      </a>
    </div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Nama</th>
              <th>Tanggal</th>
              <th>Status</th>
              <th class="col-hide-mobile">Jam Masuk</th>
              <th class="col-hide-mobile">Lembur</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentAttendances.length === 0) { %>
              <tr>
                <td colspan="5" class="text-center text-muted">
                  <div class="empty-state">
                    <i data-lucide="inbox"></i>
                    <p>Belum ada data absensi</p>
                  </div>
                </td>
              </tr>
            <% } else { %>
              <% recentAttendances.forEach(function(a, i) { %>
                <tr>
                  <td>
                    <div class="employee-name-cell">
                      <div class="employee-avatar"><%= a.employee_name.charAt(0).toUpperCase() %></div>
                      <strong><%= a.employee_name %></strong>
                    </div>
                  </td>
                  <td>
                    <%= new Date(a.date + 'T00:00:00').toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                  </td>
                  <td>
                    <% if (a.status === 'Hadir') { %>
                      <span class="badge badge-success"><i data-lucide="check"></i> Hadir</span>
                    <% } else if (a.status === 'Lembur') { %>
                      <span class="badge" style="background:#8b5cf6; color:white;"><i data-lucide="moon"></i> Lembur</span>
                    <% } else if (a.status === 'Tidak Hadir') { %>
                      <span class="badge badge-danger"><i data-lucide="x"></i> Tidak Hadir</span>
                    <% } else if (a.status === 'Setengah Hari') { %>
                      <span class="badge badge-warning"><i data-lucide="clock"></i> Setengah Hari</span>
                    <% } else { %>
                      <span class="badge badge-secondary"><%= a.status %></span>
                    <% } %>
                  </td>
                  <td class="col-hide-mobile">
                    <% if (a.arrival_time) { %>
                      <span class="time-badge"><i data-lucide="clock-3"></i> <%= a.arrival_time %></span>
                    <% } else { %><span class="text-muted">-</span><% } %>
                  </td>
                  <td class="col-hide-mobile">
                    <% if (a.is_overtime) { %>
                      <span class="badge badge-overtime-pill">🌙 Lembur</span>
                    <% } else { %><span class="text-muted">-</span><% } %>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
